APP_ENV=local
PARTNER_TOKEN=replace-with-random-partner-token
PLATFORM_TOKEN=replace-with-random-platform-token
ORDER_TOKEN_SECRET=replace-with-at-least-32-random-characters
ORDER_CONFIRMATION_TIMEOUT=2m
VENUE_REQUEST_TIMEOUT=3s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE=10s
OUTBOX_WORKERS=2
OUTBOX_MAX_ATTEMPTS=5
CHECKOUT_CONCURRENCY=32
CHECKOUT_RATE_LIMIT=100
VENUE_STAFF_TOKEN=replace-with-random-venue-staff-token
PARTNER_VENUE_ID=00000000-0000-4000-8000-000000000001
CORS_ALLOWED_ORIGINS=http://localhost:8081
MAX_REQUEST_BODY_BYTES=1048576
MAX_HEADER_BYTES=1048576
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=3s
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
PLATFORM_REQUEST_TIMEOUT=3s
MENU_PUBLISH_TIMEOUT=10s
CALLBACK_POLL_INTERVAL=500ms
CALLBACK_LEASE=10s
CALLBACK_WORKERS=2
# One-shot fault, only honored when APP_ENV=test:
VENUE_TEST_DECISION_DELAY=0s
VENUE_TEST_DECISION_STATUS=0
